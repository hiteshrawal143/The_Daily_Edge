# LifeTimeLibrary Zero-Cost Configuration
# Copy this file to .env and fill in only what you use.
# NEVER put paid API keys or credit-card-backed credentials here.

# Recipient Email (leave blank until you explicitly approve sending test emails)
RECIPIENT_EMAIL=
SENDER_NAME=LifeTimeLibrary Personal AI University

# Timezone & Schedule
TIMEZONE=Asia/Kolkata
DAILY_BRIEF_HOUR=7

# Google Integration Mode: "local_only" | "apps_script_bridge" | "google_oauth"
GOOGLE_SYNC_MODE=local_only

# Option 1 (Simplest, zero Cloud Console): Google Apps Script Web App URL + shared secret
APPS_SCRIPT_WEBAPP_URL=
APPS_SCRIPT_SHARED_SECRET=

# Option 2 (Free Google Cloud OAuth Desktop): Paths to local OAuth files (gitignored)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
GOOGLE_SPREADSHEET_NAME=LifeTimeLibrary Knowledge Database
GOOGLE_DRIVE_ROOT_FOLDER=LifeTimeLibrary

# Safety Guard (must remain false; never send emails automatically until approved)
ALLOW_EMAIL_SEND=false
